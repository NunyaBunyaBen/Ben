---
interface Props {
  name: string;
  price: string;
  description: string;
  features: string[];
  highlighted?: boolean;
  cta: string;
  ctaHref: string;
}

const { name, price, description, features, highlighted = false, cta, ctaHref } = Astro.props;
---

<div class:list={[
  "relative p-8 rounded-xl border flex flex-col h-full",
  highlighted
    ? "bg-gradient-to-b from-teal/10 to-magenta/5 border-teal/40 shadow-[0_0_60px_rgba(0,229,204,0.1)]"
    : "bg-dark-card border-white/10 hover:border-white/20 transition-colors",
]}>
  {highlighted && (
    <div class="absolute -top-3 left-1/2 -translate-x-1/2">
      <span class="bg-gradient-to-r from-teal to-magenta text-dark text-xs font-body font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full">
        Most Popular
      </span>
    </div>
  )}

  <div class="mb-8">
    <h3 class="font-heading font-bold text-xl tracking-wider text-white mb-2">{name}</h3>
    <p class="text-white/50 text-sm mb-6">{description}</p>
    <div class="flex items-baseline gap-1">
      <span class="font-heading font-[900] text-4xl md:text-5xl text-teal">{price}</span>
      <span class="text-white/40 text-sm">/month</span>
    </div>
  </div>

  <ul class="space-y-3 mb-8 flex-1">
    {features.map((feature) => (
      <li class="flex items-start gap-3">
        <svg class="w-5 h-5 text-teal mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-white/70 text-sm">{feature}</span>
      </li>
    ))}
  </ul>

  <a
    href={ctaHref}
    class:list={[
      "inline-flex items-center justify-center px-8 py-4 font-body font-semibold text-sm uppercase tracking-widest rounded-lg transition-all text-center",
      highlighted
        ? "bg-teal text-dark hover:bg-teal/90 hover:shadow-[0_0_30px_rgba(0,229,204,0.3)]"
        : "border border-white/20 text-white hover:border-teal/50 hover:text-teal",
    ]}
  >
    {cta}
  </a>
</div>
