---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.date).toLocaleDateString("en-AU", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${post.data.title} — Nunya Bunya`} description={post.data.description}>
  <article class="pt-32 pb-20 md:pt-44 md:pb-28">
    <div class="max-w-3xl mx-auto px-6">
      <a href="/blog" class="inline-flex items-center text-white/40 text-sm font-body uppercase tracking-widest hover:text-teal transition-colors mb-8">
        &larr; Back to Blog
      </a>

      <div class="flex items-center gap-3 mb-4">
        <time class="text-white/40 text-sm font-body">{formattedDate}</time>
        <span class="text-white/20">|</span>
        <span class="text-white/40 text-sm font-body">{post.data.author}</span>
      </div>

      <h1 class="font-heading font-[900] text-3xl md:text-5xl mb-4">
        {post.data.title}
      </h1>

      <div class="flex flex-wrap gap-2 mb-10">
        {post.data.tags.map((tag) => (
          <span class="text-xs font-body font-semibold uppercase tracking-wider text-teal bg-teal/10 px-3 py-1 rounded-full">
            {tag}
          </span>
        ))}
      </div>

      <div class="prose prose-invert prose-lg max-w-none
        [&_h2]:font-heading [&_h2]:font-bold [&_h2]:text-teal [&_h2]:text-2xl [&_h2]:mt-12 [&_h2]:mb-4
        [&_h3]:font-heading [&_h3]:font-bold [&_h3]:text-white [&_h3]:text-xl [&_h3]:mt-8 [&_h3]:mb-3
        [&_p]:text-white/70 [&_p]:leading-relaxed [&_p]:mb-4
        [&_strong]:text-white [&_strong]:font-semibold
        [&_ul]:text-white/70 [&_ul]:space-y-2 [&_ul]:mb-4
        [&_ol]:text-white/70 [&_ol]:space-y-2 [&_ol]:mb-4
        [&_li]:text-white/70
        [&_a]:text-teal [&_a]:hover:text-magenta
        [&_blockquote]:border-l-4 [&_blockquote]:border-teal [&_blockquote]:pl-6 [&_blockquote]:italic [&_blockquote]:text-white/50
      ">
        <Content />
      </div>

      <div class="mt-16 p-8 bg-dark-card rounded-xl border border-teal/20 text-center">
        <h3 class="font-heading font-bold text-2xl text-teal mb-3">
          WANT MORE WHERE THAT CAME FROM?
        </h3>
        <p class="text-white/60 mb-6">
          Book a free strategy call and let's talk about your marketing.
        </p>
        <a
          href="/book"
          class="inline-flex items-center justify-center px-8 py-4 bg-teal text-dark font-body font-semibold text-sm uppercase tracking-widest rounded-lg hover:bg-teal/90 transition-all hover:shadow-[0_0_30px_rgba(0,229,204,0.3)]"
        >
          Book a Call
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
