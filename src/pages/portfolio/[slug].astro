---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection("portfolio");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const formattedDate = new Date(project.data.date).toLocaleDateString("en-AU", {
  year: "numeric",
  month: "long",
});
---

<BaseLayout title={`${project.data.title} — Nunya Bunya`} description={project.data.description}>
  <article class="pt-32 pb-20 md:pt-44 md:pb-28">
    <div class="max-w-3xl mx-auto px-6">
      <a href="/portfolio" class="inline-flex items-center text-white/40 text-sm font-body uppercase tracking-widest hover:text-teal transition-colors mb-8">
        &larr; Back to Work
      </a>

      <div class="flex flex-wrap gap-2 mb-4">
        {project.data.tags.map((tag) => (
          <span class="text-xs font-body font-semibold uppercase tracking-wider text-magenta bg-magenta/10 px-3 py-1 rounded-full">
            {tag}
          </span>
        ))}
      </div>

      <p class="text-white/40 text-xs font-body font-semibold uppercase tracking-widest mb-2">
        {project.data.client} &middot; {formattedDate}
      </p>

      <h1 class="font-heading font-[900] text-3xl md:text-5xl mb-6">
        {project.data.title}
      </h1>

      {project.data.results && (
        <div class="p-6 bg-dark-card rounded-xl border border-chartreuse/20 mb-10">
          <p class="text-chartreuse text-lg font-body font-semibold">
            {project.data.results}
          </p>
        </div>
      )}

      <div class="prose prose-invert prose-lg max-w-none
        [&_h2]:font-heading [&_h2]:font-bold [&_h2]:text-teal [&_h2]:text-2xl [&_h2]:mt-12 [&_h2]:mb-4
        [&_h3]:font-heading [&_h3]:font-bold [&_h3]:text-white [&_h3]:text-xl [&_h3]:mt-8 [&_h3]:mb-3
        [&_p]:text-white/70 [&_p]:leading-relaxed [&_p]:mb-4
        [&_strong]:text-white [&_strong]:font-semibold
        [&_ul]:text-white/70 [&_ul]:space-y-2
        [&_li]:text-white/70
        [&_a]:text-teal [&_a]:hover:text-magenta
      ">
        <Content />
      </div>
    </div>
  </article>

  <CTA />
</BaseLayout>
