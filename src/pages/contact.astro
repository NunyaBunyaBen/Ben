---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact — Nunya Bunya"
  description="Get in touch with Nunya Bunya. Brisbane digital marketing agency."
>
  <section class="pt-32 pb-20 md:pt-44 md:pb-28">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">

        <!-- Left -->
        <div>
          <p class="font-body font-semibold text-magenta text-sm uppercase tracking-[0.3em] mb-4">
            Get In Touch
          </p>
          <h1 class="font-heading font-[900] text-4xl md:text-6xl leading-none mb-6">
            LET'S TALK<br />
            <span class="bg-gradient-to-r from-teal to-magenta bg-clip-text text-transparent">
              ABOUT YOUR GROWTH.
            </span>
          </h1>
          <p class="text-white/60 leading-relaxed mb-10">
            Not ready to book a call yet? No worries. Send us a message and we'll get back to you within 24 hours.
          </p>

          <div class="flex flex-col gap-4">
            <a href="mailto:ben@nunyabunya.com" class="flex items-center gap-3 text-white/60 hover:text-teal transition-colors">
              <span class="text-teal font-heading font-bold">EMAIL</span>
              <span>ben@nunyabunya.com</span>
            </a>
            <div class="flex items-center gap-3 text-white/60">
              <span class="text-teal font-heading font-bold">LOCATION</span>
              <span>Brisbane, Queensland, Australia</span>
            </div>
          </div>

          <div class="mt-10 pt-10 border-t border-white/5">
            <p class="text-white/40 text-sm mb-4">Prefer to jump straight in?</p>
            <a
              href="/book"
              class="inline-flex items-center justify-center px-8 py-4 bg-teal text-dark font-body font-semibold text-sm uppercase tracking-widest rounded-lg hover:bg-teal/90 transition-all hover:shadow-[0_0_30px_rgba(0,229,204,0.3)]"
            >
              Book a Free Strategy Call
            </a>
          </div>
        </div>

        <!-- Right: Form -->
        <div>
          <form id="contact-form" class="flex flex-col gap-5">
            <div>
              <label class="block text-white/50 text-xs uppercase tracking-widest mb-2" for="name">Name *</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="Your name"
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white placeholder:text-white/20 focus:outline-none focus:border-teal/50 transition-colors"
              />
            </div>

            <div>
              <label class="block text-white/50 text-xs uppercase tracking-widest mb-2" for="email">Email *</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="your@email.com"
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white placeholder:text-white/20 focus:outline-none focus:border-teal/50 transition-colors"
              />
            </div>

            <div>
              <label class="block text-white/50 text-xs uppercase tracking-widest mb-2" for="business">Business Name</label>
              <input
                id="business"
                name="business"
                type="text"
                placeholder="Your business (optional)"
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white placeholder:text-white/20 focus:outline-none focus:border-teal/50 transition-colors"
              />
            </div>

            <div>
              <label class="block text-white/50 text-xs uppercase tracking-widest mb-2" for="message">Message *</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="Tell us what you're working on..."
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white placeholder:text-white/20 focus:outline-none focus:border-teal/50 transition-colors resize-none"
              ></textarea>
            </div>

            <div id="form-status" class="hidden text-sm px-4 py-3 rounded-lg"></div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full py-4 bg-teal text-dark font-body font-semibold text-sm uppercase tracking-widest rounded-lg hover:bg-teal/90 transition-all hover:shadow-[0_0_30px_rgba(0,229,204,0.3)] disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const status = document.getElementById("form-status") as HTMLDivElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.textContent = "Sending...";
    btn.disabled = true;
    status.className = "hidden text-sm px-4 py-3 rounded-lg";

    const data = {
      name: (document.getElementById("name") as HTMLInputElement).value,
      email: (document.getElementById("email") as HTMLInputElement).value,
      business: (document.getElementById("business") as HTMLInputElement).value,
      message: (document.getElementById("message") as HTMLTextAreaElement).value,
    };

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const json = await res.json();

      if (res.ok) {
        status.textContent = "Message sent! We'll be in touch within 24 hours.";
        status.className = "text-sm px-4 py-3 rounded-lg bg-teal/10 text-teal border border-teal/20";
        form.reset();
      } else {
        status.textContent = json.error || "Something went wrong. Please try again.";
        status.className = "text-sm px-4 py-3 rounded-lg bg-magenta/10 text-magenta border border-magenta/20";
      }
    } catch {
      status.textContent = "Something went wrong. Please email us directly.";
      status.className = "text-sm px-4 py-3 rounded-lg bg-magenta/10 text-magenta border border-magenta/20";
    }

    btn.textContent = "Send Message";
    btn.disabled = false;
  });
</script>
